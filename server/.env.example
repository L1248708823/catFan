# 复制成 server/.env 再填真实值。这个文件已被 gitignore。
#
# 真实值在服务器的 /etc/catfan/catfan.env（0600，root 所有）：
#   ssh root@117.72.221.110 "cat /etc/catfan/catfan.env" > server/.env
#
# 本地连服务器上的 MySQL，先开隧道：
#   ssh -N -L 3307:127.0.0.1:3307 root@117.72.221.110
#
# 本地写进去的就是服务器上的真实数据。

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=catfan
MYSQL_USER=catfan_app
MYSQL_PASSWORD=

# 只绑回环，公网走 nginx 反代。
PORT=3000
HOST=127.0.0.1
